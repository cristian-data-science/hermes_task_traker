# ============================================================
# Hermes Task Tracker — Variables de entorno
# ============================================================
# Copia este archivo a `.env.local` y completa los valores.
# `.env.local` está ignorado por git (ver .gitignore) — nunca lo commitees.
#
# Además, HERMES_RSA_PUBLIC_KEY y HERMES_ADMIN_TOKEN deben configurarse como
# SECRETOS en Convex (no bastan en .env.local para el backend):
#   npx convex env set HERMES_RSA_PUBLIC_KEY "$(cat rsa_pub.pem)"
#   npx convex env set HERMES_ADMIN_TOKEN "<token-admin-aleatorio>"
# ============================================================

# URL del deployment de Convex (la que te da `npx convex dev` o `npx convex deploy`).
# Es PÚBLICA por diseño: viaja en el bundle del cliente. La seguridad no depende
# de mantenerla oculta, sino de la verificación de sesión en cada función.
VITE_CONVEX_URL=https://<tu-deployment>.convex.cloud

# CLAVE PÚBLICA RSA (PEM, multilínea). Verifica las firmas del login.
# Se genera junto a tu clave privada:
#   openssl genpkey -algorithm RSA -out rsa_key.p8 -pkeyopt rsa_keygen_bits:4096
#   openssl rsa -in rsa_key.p8 -pubout -out rsa_pub.pem
# rsa_pub.pem (esta) va AL SERVIDOR como secreto de Convex.
# rsa_key.p8 es TU CLAVE PRIVADA: la arrastras para iniciar sesión. NO la subas.
HERMES_RSA_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Token para operaciones administrativas (el script `npm run seed` lo usa para
# ejecutar resetAndSeed, que borra toda la base de datos). Genera uno aleatorio
# largo. Debe estar como secreto en Convex Y aquí (para el script local).
HERMES_ADMIN_TOKEN=genera-un-token-aleatorio-largo
